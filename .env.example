# Blockchain Configuration
# Set to true to enable cryptocurrency-based economy
BLOCKCHAIN_ENABLED=false

# Polygon RPC URL (use Mumbai testnet for testing)
# Mainnet: https://polygon-rpc.com
# Mumbai Testnet: https://rpc-mumbai.maticvigil.com
POLYGON_RPC_URL=https://polygon-rpc.com

# RuneGoldToken smart contract address (deployed on Polygon)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key for the server wallet (used for contract interactions)
# WARNING: Never commit this key to version control!
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here

# Polygon Network ID
# Mainnet: 137
# Mumbai Testnet: 80001
NETWORK_ID=137
